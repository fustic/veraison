{
  "expo": {
    "name": "Veraison",
    "slug": "veraison",
    "scheme": "veraison",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.fustic.veraison",
      "supportsTablet": false
    },
    "android": {
      "package": "com.fustic.veraison",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7A1F3D"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "require-corp",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.463285819168-qsvsuaen7b2edacpemmn8p3vmf2s4v0i"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Veraison uses the camera to photograph wine labels for your tasting notes.",
          "photosPermission": "Veraison lets you pick a photo of a wine label for your tasting notes.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Veraison",
      "shortName": "Veraison",
      "themeColor": "#7A1F3D",
      "backgroundColor": "#F4F5F2"
    }
  }
}
