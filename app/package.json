{
  "name": "veraison-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "sh ./scripts/install-deps.sh",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "upgrade": "sh ./scripts/upgrade.sh",
    "web": "expo start --web",
    "build:web": "expo export -p web"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.0",
    "expo": "^57.0.28",
    "expo-build-properties": "~57.0.20",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "maplibre-gl": "~5.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
